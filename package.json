{
  "name": "spacekit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build.mjs",
    "lint": "eslint src scripts tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test tests/e2e/fixtures.spec.ts",
    "test:canary": "playwright test tests/e2e/canary.spec.ts",
    "size": "size-limit",
    "ci": "npm run lint && npm run typecheck && npm test && npm run build && npm run size && npm run test:e2e",
    "tunnel": "node scripts/tunnel.mjs"
  },
  "dependencies": {
    "preact": "^10.26.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261023.1",
    "@playwright/test": "^1.50.1",
    "@size-limit/file": "^11.2.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.13.5",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.21.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.5.1",
    "size-limit": "^11.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
